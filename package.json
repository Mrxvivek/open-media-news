{
  "name": "open-media-news",
  "version": "1.0.0",
  "description": "OPEN MEDIA News Platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "build": "npm --prefix server install && npm --prefix server run build && npm --prefix server run prisma:generate && npm --prefix server run prisma:push",
    "postinstall": "prisma generate --schema=./server/prisma/schema.prisma",
    "seed": "npm --prefix server run seed"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.21.1",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  }
}
